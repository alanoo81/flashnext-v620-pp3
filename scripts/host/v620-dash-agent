class Agent:
    def __init__(self):
        self.hist = collections.deque(maxlen=40)   # (t, prompt_total, gen_total)
        self.mhist = collections.deque(maxlen=80)  # (t, dict des compteurs cumulés) pour les moyennes par fenêtre
        self.busy = collections.deque(maxlen=80)   # (t, secondes occupées cumulées, jetons générés cumulés pendant l occupation)
        self.timeline = collections.deque(maxlen=60)  # un point par relevé : phase (prefill/génération/mixte/inactif) et débits
        self.last_kv = None; self.gl_now = []
        self.busy_acc = [0.0, 0.0]                 # depuis le démarrage du serveur
        self.action = dict(last=None, result=None, ts=None, busy=False)
        self.models = []
        self.models_ts = 0
        self.ready_since = None
        self.last_rate = {}

    def refresh_models(self):
        if time.time() - self.models_ts < 60:
            return
        out = sh(["pct", "exec", CT, "--", "sh", "-c", f"ls -d {MODELS_ROOT}/*/config.json 2>/dev/null"])
        self.models = sorted(p.split("/")[-2] for p in out.split() if p.startswith(MODELS_ROOT)) or self.models
        self.models_ts = time.time()

    def probe_ct(self):
        out = sh(["pct", "exec", CT, "--", "sh", "-c", CT_PROBE], timeout=20)
        parts = re.split(r"^===([A-Z]+)\n?", out, flags=re.M)
        head, sec = parts[0].strip(), {}
        for i in range(1, len(parts) - 1, 2):
            sec[parts[i]] = parts[i + 1]
        v = dict(health=head[:3] if head else "", model=None, running=None, waiting=None, kv_pct=None,
                 cache_hit_pct=None, prompt_total=None, gen_total=None, container=(sec.get("DOCKER", "").strip() or None),
                 native=(sec.get("NATIVE", "").strip() == "yes"))
        try:
            v["model"] = json.loads(sec.get("MODELS", ""))["data"][0]["id"]
        except Exception:
            pass
        m = {}
        for line in sec.get("METRICS", "").splitlines():
            mm = re.match(r"^vllm:(\w+)(?:\{[^}]*\})?\s+([0-9.eE+-]+)", line)
            if mm:
                m[mm.group(1)] = m.get(mm.group(1), 0.0) + float(mm.group(2))
        if m:
            v.update(running=int(m.get("num_requests_running", 0)), waiting=int(m.get("num_requests_waiting", 0)),
                     prompt_total=m.get("prompt_tokens_total"), gen_total=m.get("generation_tokens_total"))
            kv = m.get("kv_cache_usage_perc", m.get("gpu_cache_usage_perc"))
            if kv is not None:
                v["kv_pct"] = round(kv * 100, 1)
            q = m.get("prefix_cache_queries_total") or 0
            if q:
                v["cache_hit_pct"] = round(100 * (m.get("prefix_cache_hits_total") or 0) / q, 1)
        v["state"] = ("prêt" if v["health"] == "200" else "arrêt en cours" if self.action.get("busy") and self.action["last"] == "stop"
                      else "démarrage" if (v["container"] or "").startswith("Up") or v["native"] else "arrêté")
        if v["state"] == "prêt":
            self.ready_since = self.ready_since or time.time()
        else:
            self.ready_since = None
            self.hist.clear()
        v["ready_for_s"] = int(time.time() - self.ready_since) if self.ready_since else None
        # « démarré depuis » = date de démarrage du conteneur (survit aux redémarrages de cet agent)
        st = DEVS_CACHE.get("started")
        v["container_started"] = st
        try:
            import datetime
            t = datetime.datetime.fromisoformat(st.replace("Z", "+00:00")[:26] + "+00:00") if st else None
            v["container_up_s"] = int(time.time() - t.timestamp()) if t else None
        except Exception:
            v["container_up_s"] = None
        now = time.time()
        if v["prompt_total"] is not None:
            self.hist.append((now, v["prompt_total"], v["gen_total"] or 0))
        # Débit instantané = différence entre les deux derniers relevés (3 s) quand des jetons ont été produits ;
        # on garde en plus le dernier débit non nul observé (une requête de 200 jetons dure moins de 10 s).
        v["prompt_tps_now"] = v["gen_tps_now"] = None
        if len(self.hist) >= 2:
            (t0, p0, g0), (t1, p1, g1) = self.hist[-2], self.hist[-1]
            if t1 - t0 > 0.5:
                if p1 > p0:
                    v["prompt_tps_now"] = round((p1 - p0) / (t1 - t0), 1)
                if g1 > g0:
                    v["gen_tps_now"] = round((g1 - g0) / (t1 - t0), 1)
        for key in ("prompt", "gen"):
            if v[f"{key}_tps_now"] and v[f"{key}_tps_now"] * 3 >= 30:   # ignore les fins de requête (quelques jetons)
                self.last_rate[key] = (v[f"{key}_tps_now"], int(now))
            v[f"{key}_tps_last"], v[f"{key}_tps_last_ts"] = self.last_rate.get(key, (None, None))
        old = [h for h in self.hist if now - h[0] >= 58]
        v["prompt_tps60"] = v["gen_tps60"] = None
        if old and self.hist[-1][0] - old[-1][0] > 1:
            t0, p0, g0 = old[-1]; t1, p1, g1 = self.hist[-1]
            v["prompt_tps60"] = round((p1 - p0) / (t1 - t0), 1); v["gen_tps60"] = round((g1 - g0) / (t1 - t0), 1)
        # Moyennes « à la vLLM » : rapports de compteurs cumulés (temps passé en prefill / en décodage par requête,
        # TTFT, MTP), sur la dernière minute et depuis le démarrage — indépendantes des temps morts, contrairement
        # au débit brut jetons / temps mur.
        if m:
            # temps « occupé » = intervalles entre relevés où au moins une requête était en cours ; jetons générés dessus
            if self.mhist:
                t_prev, m_prev = self.mhist[-1]
                dt = now - t_prev
                dg = m.get("generation_tokens_total", 0) - m_prev.get("generation_tokens_total", 0)
                self._pending_busy = (dt, dg)   # comptabilisé plus bas, une fois la phase connue
            if self.mhist:
                t_prev, m_prev = self.mhist[-1]; dt = max(0.5, now - t_prev)
                dp = m.get("prompt_tokens_total", 0) - m_prev.get("prompt_tokens_total", 0)
                dg = m.get("generation_tokens_total", 0) - m_prev.get("generation_tokens_total", 0)
                kv_now, kv_prev = v.get("kv_pct"), self.last_kv
                pool = DEVS_CACHE.get("pool") or 0
                kv_growth_tok = max(0.0, (kv_now - kv_prev) / 100 * pool) if (kv_now is not None and kv_prev is not None) else 0.0
                busy = sum(g.get("busy") or 0 for g in self.gl_now) / max(1, len(self.gl_now)) if self.gl_now else 0
                # la génération alloue aussi des blocs KV (1 jeton = 1 emplacement) : seule la croissance AU-DELÀ des jetons
                # générés trahit un prefill en cours
                prefilling = dp > 50 or (kv_growth_tok - dg) > 300 or (busy > 80 and dg / dt < 3 and (v["running"] or 0) > 0)
                generating = dg / dt >= 3
                phase = "mixte" if prefilling and generating else "prefill" if prefilling else "génération" if dg > 0 else "inactif"
                pf = round(max(dp, kv_growth_tok - dg) / dt) if prefilling else 0   # compteur (fin de requête) ou croissance du KV hors génération
                self.timeline.append(dict(t=int(now), phase=phase, prefill=pf, gen=round(dg / dt, 1), running=v["running"], waiting=v["waiting"], busy=round(busy), kv=v.get("kv_pct")))
                self.last_kv = kv_now
                # « génération agrégée » = jetons générés / temps des relevés en phase génération ou mixte ; les relevés
                # de prefill (où les autres requêtes ne reçoivent qu un jeton par chunk, ~1 j/s) sont exclus.
                if phase in ("génération", "mixte") and dg > 0:
                    self.busy_acc[0] += dt; self.busy_acc[1] += dg
            self.mhist.append((now, m)); self.busy.append((now, self.busy_acc[0], self.busy_acc[1]))
        elif v["state"] != "prêt":
            self.mhist.clear(); self.busy.clear(); self.busy_acc = [0.0, 0.0]
        def stats(m0, m1):
            d = lambda k: (m1.get(k, 0) - (m0.get(k, 0) if m0 else 0))
            r = dict(requetes=int(d("request_generation_tokens_count")))
            pt, ptime = d("request_prompt_tokens_sum"), d("request_prefill_time_seconds_sum")
            gt, dtime, steps = d("request_generation_tokens_sum"), d("request_decode_time_seconds_sum"), d("inter_token_latency_seconds_count")
            tt, tc = d("time_to_first_token_seconds_sum"), d("time_to_first_token_seconds_count")
            dr, ac = d("spec_decode_num_draft_tokens_total"), d("spec_decode_num_accepted_tokens_total")
            r["prefill_tps"] = round(pt / ptime, 0) if ptime > 0.05 else None
            r["decode_tps_flux"] = round(gt / dtime, 1) if dtime > 0.05 else None
            r["ms_par_pas"] = round(1000 * dtime / steps, 1) if steps else None
            r["jetons_par_pas"] = round(gt / steps, 2) if steps else None
            r["ttft_s"] = round(tt / tc, 2) if tc else None
            r["prompt_moyen"] = int(pt / tc) if tc else None
            r["mtp_acceptation_pct"] = round(100 * ac / dr, 0) if dr else None
            r["preemptions"] = int(d("num_preemptions_total"))
            return r
        v["stats_total"] = stats(None, m) if m else None
        if not m and v["state"] == "prêt" and getattr(self, "last_stats", None):
            v["stats_total"], v["stats60"], v["stats_stale"] = self.last_stats[0], self.last_stats[1], True
            self.missed = getattr(self, "missed", 0) + 1
            v["missed_probes"] = self.missed
        old = [h for h in self.mhist if now - h[0] >= 58] or ([self.mhist[0]] if self.mhist and now - self.mhist[0][0] >= 20 else [])
        v["stats60"] = stats(old[-1][1], m) if (m and old) else None
        # décodage agrégé (tous flux) = jetons générés / temps occupé ; concurrence moyenne = Σ temps de décodage / temps occupé
        def agg(st, b0, b1):
            if st is None or b1 is None: return
            bt, bg = b1[1] - (b0[1] if b0 else 0), b1[2] - (b0[2] if b0 else 0)
            st["gen_agrege_tps"] = round(bg / bt, 1) if bt > 1 else None
            st["temps_occupe_s"] = round(bt)
        if self.busy and m:
            agg(v["stats_total"], None, self.busy[-1])
            oldb = [h for h in self.busy if now - h[0] >= 58] or ([self.busy[0]] if now - self.busy[0][0] >= 20 else [])
            agg(v["stats60"], oldb[-1] if oldb else None, self.busy[-1])
        if m:
            self.last_stats = (v["stats_total"], v["stats60"])
        console = ANSI.sub("", sec.get("LOG", ""))
        # on retire les sondes de cet agent (/metrics, /v1/models, /health toutes les 3 s) du journal affiché
        lines = [l for l in console.splitlines() if not re.search(r'"GET /(metrics|v1/models|health) HTTP', l)]
        console = "\n".join(line[:400] for line in lines[-150:])
        return v, console

    # ---- actions -------------------------------------------------------------------------
    def read_request(self):
        try:
            with open(CMD_FILE) as f:
                kv = dict(line.split("=", 1) for line in f.read().splitlines() if "=" in line)
            os.remove(CMD_FILE)
        except OSError:
            return None
        return kv

    def run_action(self, kv):
        a, p, m = kv.get("action", ""), kv.get("profile", ""), kv.get("model", "")
        if self.action.get("busy") and time.time() - (self.action.get("ts") or 0) > 240:
            self.action.update(busy=False, result="délai dépassé, action abandonnée")   # garde-fou contre un worker bloqué
        if self.action.get("busy"):
            self.action.update(result="une action est déjà en cours, requête ignorée", ts=time.time()); return
        if a in ("fancurve", "fancurve_reset"):
            if a == "fancurve_reset":
                try: os.remove(FAN_CURVE_FILE)
                except OSError: pass
                self.action.update(last="courbe de ventilation : défaut", result="rétablie (45:30 60:55 75:85)", ts=time.time()); return
            try:
                pts = [tuple(int(x) for x in pt.split(":")) for pt in kv.get("points", "").split(",") if pt]
            except ValueError:
                pts = []
            if not valid_fan_curve(pts):
                self.action.update(last="courbe de ventilation", result=f"refusée : {len(pts)} point(s), il faut des températures croissantes ≤ {FAN_TMAX} °C et {FAN_PMIN}-100 %", ts=time.time()); return
            os.makedirs(os.path.dirname(FAN_CURVE_FILE), exist_ok=True)
            with open(FAN_CURVE_FILE + ".tmp", "w") as f:
                f.write("".join(f"{t} {p}\n" for t, p in pts))
            os.replace(FAN_CURVE_FILE + ".tmp", FAN_CURVE_FILE)
            self.action.update(last="courbe de ventilation", result="appliquée : " + " ".join(f"{t}:{p}" for t, p in pts) + " (relue par gpu-fan-control sous 5 s)", ts=time.time()); return
        if a == "stop":
            cmd = "cd /root && ./vllm-pp3.sh stop >/dev/null 2>&1; ./vllm-native-pp3.sh stop >/dev/null 2>&1; echo stop-ok"
            label = "stop"
        elif a == "start" and p in PROFILES:
            # Verrou de sécurité : pas de charge GPU sans ventilation pilotée. Après une mise à jour du noyau, les
            # modules hors-arbre (arctic_fan_controller, amdgpu patché) manquent : ventilateur non commandé ET
            # plafond de puissance remonté à 250 W d'usine. Vu le 24/09. Voir « Après une mise à jour du noyau ».
            fan_ok = sh(["systemctl", "is-active", "gpu-fan-control"]).strip() == "active"
            caps = [rdi(h + "/power1_cap", 1e6) for h in sorted(glob.glob("/sys/class/drm/card[0-9]/device/hwmon/hwmon*"))]
            if not fan_ok or any(c and c > 200 for c in caps):
                self.action.update(last=f"start {p}", result="REFUSÉ : " + ("ventilation GPU hors service (gpu-fan-control inactif)" if not fan_ok else "")
                                   + (" ; " if not fan_ok and any(c and c > 200 for c in caps) else "")
                                   + (f"plafond de puissance à {max(c for c in caps if c):.0f} W (module amdgpu patché absent ?)" if any(c and c > 200 for c in caps) else "")
                                   + " — relancer v620-rebuild-amdgpu ou démarrer sur le noyau précédent, puis redémarrer l'hôte", ts=time.time()); return
            prof = PROFILES[p]
            self.refresh_models()
            if m not in self.models:
                m = prof["default_model"]
            if m not in self.models:
                self.action.update(last=f"start {p}", result=f"modèle inconnu : {m}", ts=time.time()); return
            env = dict(COMMON); env.update(prof["env"]); env["MODEL"] = f"{MODELS_ROOT}/{m}"
            env.setdefault("DEVS", DEVS_DEFAULT)
            envstr = " ".join(f"{k}={shlex.quote(v)}" for k, v in env.items())
            # tout est redirigé/détaché côté CT : aucun descendant ne doit hériter du tube de sortie de pct exec
            cmd = (f"cd /root && ./vllm-pp3.sh stop >/dev/null 2>&1 </dev/null; ./vllm-native-pp3.sh stop >/dev/null 2>&1 </dev/null; "
                   f"setsid env {envstr} ./vllm-pp3.sh start > /root/dash-launch.log 2>&1 </dev/null && echo start-ok")
            label = f"start {p} ({m})"
        else:
            self.action.update(last=str(kv)[:80], result="requête refusée (hors liste blanche)", ts=time.time()); return
        self.action.update(last=label, result="en cours…", ts=time.time(), busy=True)
        def worker():
            out = sh(["pct", "exec", CT, "--", "sh", "-c", cmd], timeout=180)
            ok = "start-ok" in out or "stop-ok" in out
            self.action.update(result="lancé, voir la console" if ok and a == "start" else "arrêté" if ok else f"échec : {out.strip()[-160:] or 'pas de réponse'}", ts=time.time(), busy=False)
        threading.Thread(target=worker, daemon=True).start()

    def loop(self):
        os.makedirs(STATUS_DIR, exist_ok=True)
        while True:
            t0 = time.time()
            try:
                kv = self.read_request()
                if kv:
                    self.run_action(kv)
                self.refresh_models()
                refresh_devs()
                gl = gpus(); self.gl_now = gl
                v, console = self.probe_ct()
                v["running_profile"] = DEVS_CACHE.get("running")
                v["timeline"] = list(self.timeline)
                v["phase"] = self.timeline[-1]["phase"] if self.timeline and v["state"] == "prêt" else None
                st = dict(ts=int(t0), gpus=gl, fan=fan(gl), vllm=v,
                          fan_service=sh(["systemctl", "is-active", "gpu-fan-control"]).strip(),
                          action={k: self.action[k] for k in ("last", "result", "ts", "busy")},
                          profiles=[dict(id=k, label=p["label"], default_model=p["default_model"]) for k, p in PROFILES.items()],
                          models=self.models, load=os.getloadavg()[0], hostname=os.uname().nodename)
                for name, data in (("status.json", json.dumps(st, ensure_ascii=False)), ("console.txt", console)):
                    tmp = os.path.join(STATUS_DIR, name + ".tmp")
                    with open(tmp, "w") as f:
                        f.write(data)
                    os.chmod(tmp, 0o644); os.replace(tmp, os.path.join(STATUS_DIR, name))
            except Exception as e:  # ne jamais mourir sur une lecture ratée
                print("agent:", repr(e), file=sys.stderr, flush=True)
            time.sleep(max(0.5, 3 - (time.time() - t0)))

if __name__ == "__main__":
    Agent().loop()
