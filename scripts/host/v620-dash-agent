# Cartes : card<n> DRM -> bus PCI ; le rang PP (ROCR_VISIBLE_DEVICES 0,1,2) suit l'ordre des bus.
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")

def rd(p, default=None):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return default

def rdi(p, div=1, default=None):
    v = rd(p)
    try:
        return int(v) / div if div != 1 else int(v)
    except (TypeError, ValueError):
        return default

def dpm_current(p):
    for line in (rd(p) or "").splitlines():
        if line.endswith("*"):
            m = re.search(r"(\d+)Mhz", line)
            if m:
                return int(m.group(1))
    return None

def gpus():
    out = []
    for dev in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
        if not os.path.exists(dev + "/mem_info_vram_total"):
            continue
        card = dev.split("/")[-2]
        bus = os.path.basename(os.path.realpath(dev))
        hw = (glob.glob(dev + "/hwmon/hwmon*") or [None])[0]
        g = dict(card=card, bus=bus[5:] if bus.startswith("0000:") else bus,
                 vram_used_gib=round((rdi(dev + "/mem_info_vram_used") or 0) / 2**30, 2),
                 vram_total_gib=round((rdi(dev + "/mem_info_vram_total") or 0) / 2**30, 2),
                 busy=rdi(dev + "/gpu_busy_percent"), sclk_mhz=dpm_current(dev + "/pp_dpm_sclk"),
                 mclk_mhz=dpm_current(dev + "/pp_dpm_mclk"))
        if hw:
            # pp_dpm_mclk ne marque pas toujours le niveau courant ; les capteurs hwmon freq1/freq2 (Hz) sont fiables
            f1, f2 = rdi(hw + "/freq1_input"), rdi(hw + "/freq2_input")
            if f1: g["sclk_mhz"] = round(f1 / 1e6)
            if f2: g["mclk_mhz"] = round(f2 / 1e6)
            g.update(power_w=rdi(hw + "/power1_average", 1e6), cap_w=rdi(hw + "/power1_cap", 1e6),
                     t_edge=rdi(hw + "/temp1_input", 1000), t_junction=rdi(hw + "/temp2_input", 1000),
                     t_mem=rdi(hw + "/temp3_input", 1000))
        out.append(g)
    # Étage PP de chaque carte : ROCR_VISIBLE_DEVICES du conteneur (indices HSA, eux-mêmes dans l'ordre des bus PCI :
    # 0 = 43:00, 1 = 46:00, 2 = 63:00 — vérifié le 21/09 par la VRAM chargée), le rang i prend le i-ème indice listé.
    order = sorted(out, key=lambda g: g["bus"])
    devs = DEVS_CACHE.get("devs") or [0, 1, 2]
    for g in out:
        g["pp_rank"] = None
    for rank, idx in enumerate(devs):
        if 0 <= idx < len(order):
            order[idx]["pp_rank"] = rank
    return out

DEVS_CACHE = {"devs": None, "ts": 0}
def refresh_devs():
    """Lit ROCR_VISIBLE_DEVICES du conteneur fn-pp3 (toutes les 30 s) ; défaut 0,1,2 quand rien ne tourne."""
    if time.time() - DEVS_CACHE["ts"] < 30:
        return
    DEVS_CACHE["ts"] = time.time()
    out = sh(["pct", "exec", CT, "--", "sh", "-c", "docker inspect fn-pp3 --format '{{range .Config.Env}}{{println .}}{{end}}===STARTED{{.State.StartedAt}}===ARGS{{.Args}}' 2>/dev/null"])
    ms = re.search(r"===STARTED([^=\s]+)", out)
    DEVS_CACHE["started"] = ms.group(1) if ms else None
    pool = sh(["pct", "exec", CT, "--", "sh", "-c", "docker logs fn-pp3 2>&1 | grep -oE 'GPU KV cache size: [0-9,]+' | tail -1 | tr -dc 0-9"])
    DEVS_CACHE["pool"] = int(pool) if pool.strip().isdigit() else None
    m = re.search(r"ROCR_VISIBLE_DEVICES=([0-9,]+)", out)
    DEVS_CACHE["devs"] = [int(x) for x in m.group(1).split(",")] if m else None
    # profil en cours, déduit des arguments réels du conteneur (et non de ce que le tableau de bord a lancé en dernier)
    out = re.sub(r"===STARTED[^=\s]+", "", out)   # ne pas avaler le marqueur ===ARGS qui suit sans espace
    env, args = out.split("===ARGS", 1) if "===ARGS" in out else (out, "")
    if args:
        g = lambda k: (re.search(k + r" (\S+)", args) or [None, None])[1]
        r = dict(ctx=int(g("--max-model-len") or 0) or None, seqs=int(g("--max-num-seqs") or 0) or None,
                 mtp=("num_speculative_tokens" in args), vision=("--limit-mm-per-prompt" in args),
                 kv=("--kv-cache-memory-bytes" in args), tools=("--enable-auto-tool-choice" in args),
                 longprefill=int((re.search(r"--long-prefill-token-threshold (\d+)", args) or [0, 0])[1]),
                 part=(re.search(r"VLLM_PP_LAYER_PARTITION=([0-9,]+)", env) or [None, None])[1],
                 devs=",".join(str(x) for x in DEVS_CACHE["devs"]) if DEVS_CACHE["devs"] else None)
        r["profile"] = None
        for k, p in PROFILES.items():
            e = p["env"]
            if (int(e.get("CTX", 0)) == r["ctx"] and ("num_speculative_tokens" in e.get("EXTRA", "")) == r["mtp"]
                    and (e.get("VISION") == "1") == r["vision"] and ("--kv-cache-memory-bytes" in e.get("EXTRA", "")) == r["kv"]
                    and (int(e.get("SEQS", 4)) == (r["seqs"] or 4))
                    and (int(e.get("LONGPREFILL", 0)) == r["longprefill"])):
                r["profile"] = k; r["label"] = p["label"]; break
        DEVS_CACHE["running"] = r
    else:
        DEVS_CACHE["running"] = None

FAN_CURVE_FILE = "/etc/v620/fan-curve"
FAN_CURVE_DEFAULT = [(45, 30), (60, 55), (75, 85)]
FAN_TMAX, FAN_PMIN = 80, 30

def read_fan_curve():
    """Points (temp, pct) du fichier de courbe s'il est valide, sinon la courbe par défaut ; même règles que gpu-fan-control."""
    try:
        pts = [tuple(int(x) for x in l.split()) for l in open(FAN_CURVE_FILE) if l.strip()]
        if valid_fan_curve(pts):
            return pts, "fichier"
    except (OSError, ValueError):
        pass
    return FAN_CURVE_DEFAULT, "défaut"

def valid_fan_curve(pts):
    if not 1 <= len(pts) <= 8:
        return False
    last = -1
    for t, p in pts:
        if not (last < t <= FAN_TMAX and FAN_PMIN <= p <= 100):
            return False
        last = t
    return True

def fan(gl):
    hw = None
    for n in glob.glob("/sys/class/hwmon/hwmon*/name"):
        if rd(n) == "arctic_fan":
            hw = os.path.dirname(n)
    f = dict(present=hw is not None)
    if hw:
        pwm = rdi(hw + "/pwm1")
        f.update(pwm=pwm, pct=round(pwm * 100 / 255) if pwm is not None else None, rpm=rdi(hw + "/fan1_input"))
    f["worst_junction"] = max([g.get("t_junction") or 0 for g in gl] or [0])
    f["worst_temp"] = max([max(g.get("t_junction") or 0, g.get("t_mem") or 0) for g in gl] or [0])  # gpu-fan-control suit max(junction, mémoire)
    pts, src = read_fan_curve()
    f["curve_points"] = pts; f["curve_source"] = src; f["curve_default"] = FAN_CURVE_DEFAULT
    f["curve_rules"] = dict(tmax=FAN_TMAX, pmin=FAN_PMIN, failsafe=85, max_points=8)
    f["curve"] = " · ".join(f"{t} °C : {p} %" for t, p in pts) + f" · > {pts[-1][0]} °C : 100 % · sécurité ≥ 85 °C : 100 %"
    return f

def sh(cmd, timeout=10):
    """Exécute cmd dans sa propre session ; au délai, tue toute la session (pct exec laisse des petits-enfants qui
    garderaient les tubes ouverts et bloqueraient subprocess.run pour toujours)."""
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                             text=True, start_new_session=True)
    except OSError:
        return ""
    try:
        out, _ = p.communicate(timeout=timeout)
        return out
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, 9)
        except OSError:
            pass
        try:
            out, _ = p.communicate(timeout=5)
        except Exception:
            out = ""
        return out or ""

