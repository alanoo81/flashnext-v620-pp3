From e83a8510bca5542b5c2b442b0d0531105fd34d33 Mon Sep 17 00:00:00 2001
From: root <root@llama.2cprtech.com>
Date: Thu, 17 Sep 2026 15:41:44 +0000
Subject: [PATCH 12/16] v620 MTP: image_token_index fallback for Qwen4Exp in
 the drafter loader

---
 vllm/v1/spec_decode/llm_base_proposer.py | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/vllm/v1/spec_decode/llm_base_proposer.py b/vllm/v1/spec_decode/llm_base_proposer.py
index ccff43ca64..15ced435c7 100644
--- a/vllm/v1/spec_decode/llm_base_proposer.py
+++ b/vllm/v1/spec_decode/llm_base_proposer.py
@@ -1407,9 +1407,10 @@ class SpecDecodeBaseProposer:
                     target_model.config.media_placeholder_token_id
                 )
             else:
-                self.model.config.image_token_index = (
-                    target_model.config.image_token_index
-                )
+                self.model.config.image_token_index = getattr(
+                    target_model.config, "image_token_index",
+                    getattr(target_model.config, "image_token_id", None),
+                )  # v620: Qwen4Exp exposes image_token_id only
             target_language_model = cast(
                 SupportsMultiModal, target_model
             ).get_language_model()
