@@ -637,10 +637,10 @@ class Qwen4ExpModel(nn.Module):
             orig_to_new_substr={substr: None for substr in skip_substrs}
         )
         # v620-pp3: the final mixer only exists on the last pipeline stage
-        skip_prefixes = [] if get_pp_group().is_last_rank else ["hyper_connection_mixer."]
