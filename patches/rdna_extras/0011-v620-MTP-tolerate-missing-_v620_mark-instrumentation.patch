diff --git a/vllm/v1/ple_offload/connector.py b/vllm/v1/ple_offload/connector.py
index 70064bdbb4..5e1ec8bbcd 100644
--- a/vllm/v1/ple_offload/connector.py
+++ b/vllm/v1/ple_offload/connector.py
@@ -4,7 +4,11 @@
 
 import os
 _V620_TRACE = os.environ.get("V620_PLE_TRACE") == "1"
-from vllm.model_executor.layers.ple_offload_layer import _v620_mark
+try:
+    from vllm.model_executor.layers.ple_offload_layer import _v620_mark
+except ImportError:  # instrumentation V620 absente sur cet arbre
+    def _v620_mark(*a, **k):
+        return None
