diff --git a/v620_dump.py b/v620_dump.py
new file mode 100644
index 0000000000..e9bdc7b854
--- /dev/null
+++ b/v620_dump.py
@@ -0,0 +1,76 @@
+# Instrumentation V620 : hooks forward sur chaque couche décodeur Qwen4Exp (et ses sous-modules de 1er niveau),
+# enregistre par étape (chunk de prefill / pas de décodage) les vecteurs du dernier token et du token 100,
+# plus des stats globales, pour comparer deux arbres vLLM couche par couche.
+# Activation : V620_DUMP=<dossier de sortie> ; V620_DUMP_STEPS=<nb d'étapes max, défaut 8>.
+import os, re, torch
+
+_STATE = {"step": -1, "first": None, "rec": {}, "dir": None, "max_steps": 8, "rank": "r?"}
+
+
+def _summ(t: torch.Tensor):
+    if not isinstance(t, torch.Tensor) or t.numel() == 0 or t.dtype in (torch.int32, torch.int64, torch.bool):
+        return None
+    x = t.detach()
+    if x.ndim == 1:
+        x = x.unsqueeze(0)
+    n = x.shape[0]
+    flat = x.reshape(n, -1).float()
+    return {
+        "shape": tuple(t.shape), "dtype": str(t.dtype), "n": n,
+        "last": flat[-1].cpu(), "t100": flat[min(100, n - 1)].cpu(),
+        "absmean": flat.abs().mean().item(), "absmax": flat.abs().max().item(),
+        "nan": int(torch.isnan(flat).sum().item()),
+    }
+
+
+def _hook(name):
+    def fn(mod, inp, out):
+        st = _STATE
+        if name == st["first"]:
+            st["step"] += 1
+            if st["step"] >= st["max_steps"]:
+                return
+        if st["step"] < 0 or st["step"] >= st["max_steps"]:
+            return
+        outs = out if isinstance(out, (tuple, list)) else (out,)
+        for i, o in enumerate(outs):
+            s = _summ(o)
+            if s is not None:
+                st["rec"].setdefault(st["step"], {})[f"{name}#{i}"] = s
+        # entrée principale de la couche (premier tenseur) pour situer une divergence en amont
+        if inp and isinstance(inp[0], torch.Tensor):
+            s = _summ(inp[0])
+            if s is not None:
+                st["rec"].setdefault(st["step"], {})[f"{name}@in"] = s
+        if name == st["last"]:
+            torch.save({"rank": st["rank"], "rec": st["rec"]}, os.path.join(st["dir"], f"rank{st['rank']}.pt"))
+    return fn
+
+
+def install(model):
+    d = os.environ.get("V620_DUMP")
+    if not d:
+        return
+    try:
+        import torch.distributed as dist
+        rank = dist.get_rank() if dist.is_initialized() else os.getpid()
+    except Exception:
+        rank = os.getpid()
+    _STATE.update(dir=d, rank=str(rank), max_steps=int(os.environ.get("V620_DUMP_STEPS", "8")))
+    os.makedirs(d, exist_ok=True)
+    layer_re = re.compile(r"^(.*\.layers\.(\d+))$")
+    layers = []
+    for name, mod in model.named_modules():
+        m = layer_re.match(name)
+        if m and type(mod).__name__ != "PPMissingLayer" and any(True for _ in mod.parameters()):
+            layers.append((int(m.group(2)), name, mod))
+    layers.sort()
+    if not layers:
+        return
+    _STATE["first"], _STATE["last"] = layers[0][1], layers[-1][1]
+    n = 0
+    for idx, name, mod in layers:
+        mod.register_forward_hook(_hook(name)); n += 1
+        for sub, smod in mod.named_children():   # ple, linear_attn/self_attn, mlp, norms, hc...
+            smod.register_forward_hook(_hook(f"{name}.{sub}")); n += 1
+    print(f"[v620_dump] rank {rank}: {n} hooks, layers {layers[0][0]}..{layers[-1][0]} -> {d}", flush=True)
