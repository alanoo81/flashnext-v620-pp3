diff --git a/vllm/model_executor/layers/rdna_dense_int8.py b/vllm/model_executor/layers/rdna_dense_int8.py
index 197f9bb461..bd0ee7232d 100644
--- a/vllm/model_executor/layers/rdna_dense_int8.py
+++ b/vllm/model_executor/layers/rdna_dense_int8.py
@@ -132,10 +132,19 @@ def make_shadow(layer: torch.nn.Module) -> None:
     n, k = w.shape
     if k % 16 != 0 or n < int(os.getenv("VLLM_RDNA_DENSE_INT8_MIN_ROWS", "64")):
         return
-    amax = w.abs().amax(dim=1).float().clamp_min(1e-8)
-    scale = (amax / 127.0)
-    q = torch.round(w.float() / scale[:, None]).clamp_(-127, 127).to(torch.int8)
-    layer.weight_i8 = q.contiguous()
+    # v620: quantise in row blocks so the fp32 temporaries stay small (the 248320-row
+    # embedding otherwise needs a 2.4 GiB fp32 copy on a card that has <1 GiB left)
+    q = torch.empty((n, k), dtype=torch.int8, device=w.device)
+    scale = torch.empty((n,), dtype=torch.float32, device=w.device)
+    step = max(1, (64 << 20) // (k * 4))
+    for r0 in range(0, n, step):
+        blk = w[r0:r0 + step].float()
+        amax = blk.abs().amax(dim=1).clamp_min(1e-8)
+        sc = amax / 127.0
+        scale[r0:r0 + step] = sc
+        q[r0:r0 + step] = torch.round(blk / sc[:, None]).clamp_(-127, 127).to(torch.int8)
+        del blk
+    layer.weight_i8 = q
     layer.weight_i8_scale = scale.to(torch.float16).contiguous()
     if only_mode():
         # Release the fp16 copy: keep the Parameter object (loader attrs, registration)
diff --git a/vllm/models/qwen4_exp/amd/mtp.py b/vllm/models/qwen4_exp/amd/mtp.py
