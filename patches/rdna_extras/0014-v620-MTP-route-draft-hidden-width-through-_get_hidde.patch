Claude-Session: https://claude.ai/code/session_01Vugn8vGjCf8fVWViDZHdko
---
 vllm/v1/spec_decode/llm_base_proposer.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/spec_decode/llm_base_proposer.py b/vllm/v1/spec_decode/llm_base_proposer.py
index 78c1008f73..b6d47da46e 100644
--- a/vllm/v1/spec_decode/llm_base_proposer.py
+++ b/vllm/v1/spec_decode/llm_base_proposer.py
@@ -95,7 +95,7 @@ class SpecDecodeBaseProposer:
         # We need to get the hidden size from the draft model config because
         # the draft model's hidden size can be different from the target model's
         # hidden size (e.g., Llama 3.3 70B).
-        self.hidden_size = self.draft_model_config.get_hidden_size()
+        self.hidden_size = self._get_hidden_size()  # v620: hook overridden by Qwen4ExpMTPProposer (hc_mult streams)
         self.inputs_embeds_size = self.draft_model_config.get_inputs_embeds_size()
 
         # DeepSeek V4 MTP consumes the target's pre-hc_head residual stream,
@@ -1436,6 +1436,10 @@ class SpecDecodeBaseProposer:
             else:
                 self.parallel_drafting_hidden_state_tensor.copy_(flat_mask)
 
+    def _get_hidden_size(self) -> int:
+        """Return the hidden width consumed by the draft model."""
+        return self.draft_model_config.get_hidden_size()
+
